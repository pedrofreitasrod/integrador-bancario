<?xml version="1.0" encoding="ISO-8859-1" ?>
<metadados xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="../.gradle/metadados.xsd">

    <table name="BCO_PARAMBANCO" sequenceType="M">
        <description>Parâmetros do integrador bancário por empresa e banco</description>
        <primaryKey>
            <field name="IDBANCO"/>
            <field name="CODEMP"/>
        </primaryKey>
        <instances>
            <instance name="BcoParamBanco">
                <description>Parâmetros do integrador bancário por empresa e banco</description>
                <relationShip>
                    <relation entityName="TipoOperacao">
                        <fields>
                            <field localName="CODTIPOPER" targetName="CODTIPOPER"/>
                        </fields>
                        <expression><![CDATA[@ref-param[force-one-to-one=true]]]></expression>
                    </relation>
                    <relation entityName="Empresa">
                        <fields>
                            <field localName="CODEMP" targetName="CODEMP"/>
                        </fields>
                    </relation>
                    <relation entityName="BcoCadBanco">
                        <fields>
                            <field localName="IDBANCO" targetName="ID"/>
                        </fields>
                    </relation>
                    <relation entityName="ContaBancaria">
                        <fields>
                            <field localName="CODCTA" targetName="CODCTABCOINT"/>
                        </fields>
                    </relation>
                </relationShip>
            </instance>
        </instances>
        <fields>
            <field name="IDBANCO" dataType="INTEIRO" nullable="N" required="S" allowSearch="S" visibleOnSearch="S">
                <description>Banco</description>
            </field>
            <field name="CODEMP" dataType="INTEIRO" nullable="N" required="S" allowSearch="S" visibleOnSearch="S">
                <description>Empresa</description>
            </field>
            <field name="CLIENTID" dataType="TEXTO" size="120" allowSearch="S" visibleOnSearch="S">
                <description>Client ID (OAuth)</description>
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
            </field>
            <field name="COOPERATIVA" dataType="TEXTO" size="10" allowSearch="S" visibleOnSearch="S">
                <description>Cooperativa / Agência</description>
            </field>
            <field name="NUMCONTA" dataType="TEXTO" size="20" allowSearch="S" visibleOnSearch="S">
                <description>Número da Conta</description>
            </field>
            <field name="NUMCONTRATO" dataType="TEXTO" size="20" allowSearch="S" visibleOnSearch="S">
                <description>Número do Contrato (cobrança)</description>
            </field>
            <field name="CERTARQUIVO" dataType="ARQUIVO" allowSearch="N" visibleOnSearch="N">
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
                <description>Arquivo do certificado (.pfx) para autenticação mTLS</description>
            </field>
            <field name="CERTSENHA" dataType="TEXTO" size="255" allowSearch="N" visibleOnSearch="N">
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
                <description>Senha do certificado</description>
            </field>
            <field name="SCOPES" dataType="TEXTO" size="500" allowSearch="N" visibleOnSearch="N">
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
                <description>Escopos OAuth (separados por espaço)</description>
            </field>
            <field name="ATIVO" dataType="CHECKBOX" allowSearch="S" visibleOnSearch="S">
                <description>Ativo</description>
                <properties>
                    <prop name="UITabName">__main</prop>
                </properties>
            </field>
            <field name="CODCTA" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>Conta Bancária (baixa)</description>
                <properties>
                    <prop name="UIGroupName">Parametrização</prop>
                </properties>
            </field>
            <field name="CODTIPOPER" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>Tipo de Operação (movimento bancário da baixa)</description>
                <properties>
                    <prop name="UIGroupName">Parametrização</prop>
                </properties>
            </field>
            <field name="ACESSTOKEN" dataType="CAIXA_TEXTO" size="4000" readOnly="S" allowSearch="N" visibleOnSearch="N">
                <description>AcessToken</description>
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
            </field>
            <field name="EXPIRES" dataType="INTEIRO" readOnly="S" allowSearch="N" visibleOnSearch="N">
                <description>Expires in</description>
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
            </field>
            <field name="DHAUTENTIQUE" dataType="DATA_HORA" readOnly="S" allowSearch="N" visibleOnSearch="N">
                <description>Hora de autenticação</description>
                <properties>
                    <prop name="UITabName">Autenticação</prop>
                </properties>
            </field>
        </fields>
    </table>

</metadados>
